{
	"name": "solvebeam/solvebeam-bootstrap-pagination",
	"description": "Transforms the default WordPress `paginate_links()` output into Bootstrap 5 pagination component markup using the WordPress HTML API.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"autoload": {
		"psr-4": {
			"SolveBeam\\WordPressBootstrapPagination\\": "psr-4/"
		}
	},
	"authors": [
		{
			"name": "SolveBeam",
			"email": "info@solvebeam.com"
		}
	],
	"config": {
		"platform": {
			"php": "8.2"
		},
		"platform-check": false,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"composer/installers": true,
			"automattic/jetpack-autoloader": true,
			"phpstan/extension-installer": true
		},
		"wp-slug": "solvebeam-bootstrap-pagination"
	},
	"require": {
		"php": "^8.2",
		"composer/installers": "^2.3",
		"automattic/jetpack-autoloader": "^5.0"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"pronamic/wp-coding-standards": "^2.5",
		"rector/rector": "^2.3",
		"roots/wordpress-no-content": "^6.7",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"vimeo/psalm": "^6.8",
		"wp-cli/dist-archive-command": "*",
		"wp-cli/wp-cli": "^2.11",
		"wp-cli/wp-cli-bundle": "*",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"extra": {
		"installer-paths": {
			"packages/{$vendor}/{$name}": [
				"vendor:pronamic",
				"vendor:solvebeam",
				"vendor:wp-pay",
				"woocommerce/action-scheduler"
			]
		}
	},
	"scripts": {
		"build": [
			"@lint",
			"@analyse",
			"@psalm",
			"rm -rf ./build",
			"mkdir ./build",
			"mkdir ./build/stage-1",
			"mkdir ./build/stage-2",
			"rsync --recursive --verbose --exclude-from=.distignore --exclude=/vendor/ ./ ./build/stage-1/",
			"composer install --no-dev --prefer-dist --optimize-autoloader --working-dir=./build/stage-1/",
			"rsync --recursive --verbose --exclude-from=.distignore ./build/stage-1/ ./build/stage-2/",
			"vendor/bin/wp i18n make-pot ./build/stage-2/ --slug=solvebeam-bootstrap-pagination",
			"vendor/bin/wp i18n make-mo ./build/stage-2/languages/",
			"vendor/bin/wp dist-archive ./build/stage-2/ --plugin-dirname=solvebeam-bootstrap-pagination"
		],
		"dist-archive": "wp dist-archive . --plugin-dirname=solvebeam-bootstrap-pagination",
		"make-pot": [
			"@build",
			"rsync --recursive --delete --verbose ./build/stage-2/languages/ ./languages/",
			"vendor/bin/wp i18n update-po ./languages/solvebeam-bootstrap-pagination.pot"
		],
		"lint": "@phpcs",
		"analyse": "@phpstan",
		"phpcs": "vendor/bin/phpcs",
		"phpstan": "vendor/bin/phpstan analyze",
		"psalm": "vendor/bin/psalm"
	}
}
